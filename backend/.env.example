# ==============================================================================
# Sistema de Préstamo Digital Interdepartamental (FAUD-UNSJ) — Configuración
# ==============================================================================

# Entorno y Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de Datos PostgreSQL 16 (Docker Compose expone 5433 para no colisionar con servicio local 5432)
DATABASE_URL="postgresql://faud_user:faud_password@localhost:5433/repositorio_faud?schema=public"

# Autenticación de Sesión (JWT) — RF05
JWT_SECRET="faud_unsj_jwt_session_secret_key_dev_2026"
JWT_EXPIRES_IN="8h"

# DRM y Préstamo Temporal (7 días) — RF03 / RF04 / RNF02
LOAN_DRM_JWT_SECRET="faud_unsj_drm_loan_7d_secret_key_dev_2026"
LOAN_DURATION_DAYS=7

# Almacenamiento Privado de Documentos PDF — RF01 / RNF02
# STORAGE_DRIVER: "local" (disco en PRIVATE_STORAGE_DIR) o "s3" (bucket privado compatible con S3)
STORAGE_DRIVER=local
PRIVATE_STORAGE_DIR="./storage/pdfs"
MAX_PDF_SIZE_MB=50

# Bucket S3 compatible — solo con STORAGE_DRIVER=s3 (ejemplo Backblaze B2; el bucket debe ser privado)
# S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
# S3_REGION="us-east-005"
# S3_BUCKET="faud-unsj-pdfs"
# S3_ACCESS_KEY_ID="<keyID de la Application Key>"
# S3_SECRET_ACCESS_KEY="<applicationKey>"

# Correo Electrónico (Mailpit en desarrollo local) — RF05 / RF06
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Biblioteca FAUD-UNSJ <biblioteca@faud.unsj.edu.ar>"
# Credenciales para un proveedor SMTP externo (Brevo, Mailtrap). Vacías con Mailpit.
# SMTP_SECURE=true solo para el puerto 465; en 587/2525 se negocia STARTTLS.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Seguridad y Rate Limiting (@nestjs/throttler) — Fase 6 Hardening
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=15
